extends partial/layout.pug

block container
    include mixins/post.pug
    - var tagData = site.tags.findOne({name: page.tag})
    - var totalPosts = tagData ? tagData.posts.length : page.posts.length
    h2.archive-year
        != "Posts tagged with '" + page.tag + "' (" + totalPosts + " items)"
    ul.home.post-list
        - page.posts.each(function (item) {
            article.home-post-block
                +postInfo(item)
                .home-post-title
                    a.post-title-link(href=url_for(item.path))
                        +postTitle(item.title)
        - })

block pagination
    include mixins/paginator.pug
    +home()

block copyright
    include partial/copyright.pug
