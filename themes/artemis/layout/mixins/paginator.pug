mixin home()
    if page.total > 1
        .paginator
            - for (var i = 1; i <= page.total; i++)
                if i === page.current
                    span.page-number.current= i
                else
                    - var pageUrl = i === 1 ? page.base || '/' : (page.base || '/') + 'page/' + i + '/'
                    a.page-number(href=url_for(pageUrl))= i

mixin post()
    - var prev = page.prev ? page.prev.path : false;
    - var next = page.next ? page.next.path : false;
    .paginator
        if prev
            a.prev(href=url_for(prev))
                != __('prev_post')
        if next
            a.next(href=url_for(next))
                != __('next_post')